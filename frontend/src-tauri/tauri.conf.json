{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Reasonframe",
  "version": "0.1.0-rc.2",
  "identifier": "com.stasryabkov.finance-terminal",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Reasonframe",
      "width": 1400,
      "height": 900,
      "minWidth": 1050,
      "minHeight": 700,
      "center": true,
      "resizable": true,
      "visible": false
    }],
    "security": { "csp": "default-src 'self'; connect-src ipc: http://127.0.0.1:*; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:" }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns"],
    "resources": [
      "binaries/reasonframe-backend",
      "resources/fred-api-key",
      "resources/edgar-identity"
    ],
    "macOS": { "signingIdentity": "-", "hardenedRuntime": false }
  }
}
