{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Permissions for the main desktop window",
  "windows": ["main"],
  "permissions": [
    "core:default",
    {
      "identifier": "opener:allow-open-url",
      "allow": [
        { "url": "https://auth.openai.com/**" },
        { "url": "https://chatgpt.com/**" },
        { "url": "https://*.openai.com/**" }
      ]
    }
  ]
}
